# Copy this file to .env and fill in real values. Never commit .env.
#
# AIForge reads provider credentials from environment variables only -- it
# never accepts keys via config files or command-line flags, so a key can't
# accidentally end up committed in aiforge.toml.

# Required to use the Anthropic (Claude) provider.
ANTHROPIC_API_KEY=

# Optional: point the Anthropic SDK at a proxy or alternate base URL.
# ANTHROPIC_BASE_URL=

# Optional: override any aiforge.toml setting without editing the file.
# Format: AIFORGE__<SECTION>__<KEY>=value (double underscore separated).
# AIFORGE__ENGINE__DEFAULT_PROVIDER=anthropic
# AIFORGE__PROVIDERS__ANTHROPIC__MODEL=claude-opus-4-8
